CONFIG_PRJ_DEFCONFIG_FILENAME="d21x_demo88-mmc_baremetal_bootloader_defconfig"
CONFIG_PRJ_CHIP="d21x"
CONFIG_PRJ_BOARD="demo88-mmc"
CONFIG_PRJ_KERNEL="baremetal"
CONFIG_PRJ_APP="bootloader"
CONFIG_PRJ_CUSTOM_LDS="application/baremetal/bootloader/ldscript/d21x_bootloader_gcc.ld"
CONFIG_AIC_USING_UART0=y
# CONFIG_AIC_USING_USB1 is not set
CONFIG_AIC_USING_SDMC0=y
CONFIG_AIC_SDMC0_CLK_FREQ=35000000
CONFIG_AIC_WIRELESS_LAN=y
CONFIG_AIC_DISP_LVDS=y
CONFIG_AIC_LVDS_LINK_0=y
CONFIG_AICFB_RGB565=y
